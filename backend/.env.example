# Port for the Node.js Express & Socket.io server
PORT=4000

# Secret key used for signing host JWTs (REQUIRED in production)
JWT_SECRET=your_long_random_jwt_secret_here

# Groq Cloud API key for AI trivia generation
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: URL of your deployed frontend (for strict CORS checking in production)
FRONTEND_URL=https://sparq-quiz.vercel.app

# Environment: development | production
NODE_ENV=development

# Optional: Extra comma-separated allowed origins for CORS (e.g. preview deployments)
# ALLOWED_ORIGINS=https://preview-1.vercel.app,https://preview-2.vercel.app

# Optional: Custom SQLite database file path (e.g., if a persistent disk is mounted on Render at /var/data/quiz.db)
# SQLITE_DB_PATH=/var/data/quiz.db
